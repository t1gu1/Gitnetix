---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/site.css';
import Header, { type Page } from '../components/Header';
import Footer from '../components/Footer';
import { u } from '../lib/changelog';
import { resolveTheme, SYSTEM, THEMES } from '../../../src/lib/themes';
import { logoSvg } from '../../../src/lib/logo';
// The hero headline's weight: preloaded so the largest text paints in its own font, not a fallback.
import heading from '@fontsource/instrument-sans/files/instrument-sans-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  page?: Page;
  type?: 'website' | 'article';
  jsonLd?: object[];
}
const { title, description, page, type = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Guillaume Huard Hughes">
<meta name="application-name" content="Gitnetix">
<meta name="color-scheme" content="dark light">
<link rel="preload" href={heading} as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={u('themes.css')}>
<script is:inline define:vars={{ themes: THEMES.map((t) => ({ id: t.id, light: t.light, own: t.family !== 'Gitnetix', accent: t.accent, panel: t.panel })), system: SYSTEM, mark: logoSvg('{accent}', '{panel}') }}>
  // The app's resolveTheme + applyTheme, before the first paint: the saved pick, or SYSTEM's theme in the computer's mode.
  // Picks come from ThemePicker.tsx's [data-pick] buttons and HeroDemo's light / dark toggle (a "themechange" event); every picker shows the one in use.
  // The favicon is the logo redrawn in the theme's colors, which a file can't read off the page.
  let pref;
  try { pref = localStorage.getItem('theme'); } catch {}
  const sys = matchMedia('(prefers-color-scheme: light)');
  const apply = () => {
    const t = themes.find((x) => x.id === pref) ?? themes.find((x) => x.id === system[sys.matches ? 'light' : 'dark']);
    const root = document.documentElement;
    root.dataset.theme = t.light ? 'light' : 'dark';
    if (t.own) root.dataset.palette = t.id;
    else delete root.dataset.palette;
    document.querySelectorAll('[data-pick]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.pick === t.id)));
    document.querySelectorAll('[data-pick-name]').forEach((s) => (s.textContent = document.querySelector(`[data-pick="${t.id}"]`).getAttribute('aria-label')));
    const icon = `data:image/svg+xml,${encodeURIComponent(mark.replaceAll('{accent}', t.accent).replaceAll('{panel}', t.panel))}`;
    document.querySelectorAll('link[data-mark]').forEach((l) => (l.href = icon));
  };
  const pick = (id) => {
    pref = id;
    try { localStorage.setItem('theme', id); } catch {}
    apply();
  };
  apply();
  sys.addEventListener('change', apply);
  addEventListener('DOMContentLoaded', apply);
  addEventListener('click', (e) => { const b = e.target.closest?.('[data-pick]'); if (b) pick(b.dataset.pick); });
  addEventListener('themechange', (e) => pick(e.detail));
</script>
<link rel="canonical" href={canonical}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content={resolveTheme('system', 'dark').bg} media="(prefers-color-scheme: dark)">
<meta name="theme-color" content={resolveTheme('system', 'light').bg} media="(prefers-color-scheme: light)">
<link rel="icon" type="image/png" sizes="64x64" href={u('favicon.png')}>
<link rel="icon" type="image/svg+xml" href={u('favicon.svg')} data-mark>
<link rel="apple-touch-icon" href={u('apple-touch-icon.png')}>
<link rel="manifest" href={u('site.webmanifest')}>
<link rel="alternate" type="application/rss+xml" title="Gitnetix releases" href={u('releases.xml')}>
<link rel="sitemap" href={u('sitemap-index.xml')}>
<meta property="og:site_name" content="Gitnetix">
<meta property="og:locale" content="en_US">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={og}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Gitnetix: see your work, not your commits. For macOS, Windows and Linux. Beside it, the app's branch tree from main to release to feature.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={og}>
<meta name="twitter:image:alt" content="Gitnetix: see your work, not your commits. For macOS, Windows and Linux. Beside it, the app's branch tree from main to release to feature.">
{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<Header page={page} />

<main id="content">
<slot />
</main>

<Footer />
</body>
</html>
