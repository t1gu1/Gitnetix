---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/site.css';
import Header, { type Page } from '../components/Header';
import Footer from '../components/Footer';
import { u } from '../lib/changelog';

interface Props {
  title: string;
  description: string;
  page?: Page;
  type?: 'website' | 'article';
  jsonLd?: object[];
}
const { title, description, page, type = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f3f3f1" media="(prefers-color-scheme: light)">
<link rel="icon" type="image/png" href={u('favicon.png')}>
<link rel="apple-touch-icon" href={u('apple-touch-icon.png')}>
<link rel="alternate" type="application/rss+xml" title="Gitnetix releases" href={u('releases.xml')}>
<link rel="sitemap" href={u('sitemap-index.xml')}>
<meta property="og:site_name" content="Gitnetix">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Gitnetix: see your work, not your commits. A branch tree from main to release to feature.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={og}>
{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<Header page={page} />

<main id="content">
<slot />
</main>

<Footer />
</body>
</html>
